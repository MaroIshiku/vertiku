# Optional local-development or external-env configuration.
# ZimaOS uses the direct values in compose.yaml instead.
# Generate at least 32 random characters. Required only for first-run administrator setup.
ISHIKU_SETUP_SECRET=REPLACE-WITH-A-UNIQUE-SECRET-OF-AT-LEAST-32-CHARACTERS
VERTIKU_PORT=8080
VERTIKU_INPUT_DIR=/input
VERTIKU_OUTPUT_DIR=/output
VERTIKU_COOKIE_SECURE=false
VERTIKU_PASSWORD_RESET=false
VERTIKU_ETA_HISTORY_RESET_TOKEN=
VERTIKU_MAX_UPLOAD_GIB=10
TZ=Europe/Berlin
