#!/usr/bin/env node
import { spawnSync } from 'node:child_process'; import { dirname, join } from 'node:path'; import { fileURLToPath } from 'node:url';
const r = spawnSync(process.execPath, [join(dirname(fileURLToPath(import.meta.url)), 'ishiku.mjs'), 'check-release', ...process.argv.slice(2)], { stdio: 'inherit' }); process.exit(r.status ?? 1);
