#!/usr/bin/env node
import { appendFileSync, mkdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
const hours = Number(process.env.SOAK_DURATION_HOURS ?? '48');
const url = process.env.SOAK_HEALTH_URL;
if (!url || !Number.isFinite(hours) || hours <= 0 || hours > 48) {
  process.stderr.write('Set SOAK_HEALTH_URL and SOAK_DURATION_HOURS between 0 and 48.\n');
  process.exit(2);
}
const reportDir = join(process.cwd(), '.ishiku', 'reports', 'soak');
mkdirSync(reportDir, { recursive: true });
const evidence = join(reportDir, 'health.ndjson');
writeFileSync(evidence, '');
const deadline = Date.now() + hours * 60 * 60 * 1000;
let failures = 0;
while (Date.now() < deadline) {
  const started = Date.now();
  try {
    const response = await fetch(url, { signal: AbortSignal.timeout(10_000) });
    if (!response.ok) failures += 1;
    appendFileSync(evidence, `${JSON.stringify({ at: new Date().toISOString(), status: response.status, latency_ms: Date.now() - started })}\n`);
  } catch (error) {
    failures += 1;
    appendFileSync(evidence, `${JSON.stringify({ at: new Date().toISOString(), error: error.message })}\n`);
  }
  await new Promise((resolve) => setTimeout(resolve, 60_000));
}
writeFileSync(join(reportDir, 'summary.json'), `${JSON.stringify({ duration_hours: hours, failures, completed_at: new Date().toISOString() }, null, 2)}\n`);
process.exit(failures === 0 ? 0 : 1);
