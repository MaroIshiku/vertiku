{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ishiku.dev/schemas/platform.schema.json",
  "type": "object",
  "required": ["schema_version", "platform_version", "family", "locale", "new_app_profile", "authentication", "updates", "completion_states"],
  "properties": {
    "schema_version": { "const": 1 },
    "platform_version": { "type": "string" },
    "family": { "const": "ishiku" },
    "locale": { "const": "en" },
    "new_app_profile": { "type": "object" },
    "authentication": { "type": "object" },
    "updates": { "type": "object" },
    "completion_states": { "const": ["BLOCKED", "IMPLEMENTED_BUT_NOT_VERIFIED", "VERIFIED"] }
  }
}
