{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ishiku.dev/schemas/override.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "reason", "policy", "security_assessment", "owner", "review_date", "tests"],
  "properties": {
    "id": { "type": "string", "pattern": "^OVR-[0-9]{3}$" },
    "reason": { "type": "string", "minLength": 20 },
    "policy": { "type": "string", "minLength": 3 },
    "security_assessment": { "type": "string", "minLength": 20 },
    "owner": { "type": "string", "minLength": 2 },
    "review_date": { "type": "string", "format": "date" },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
